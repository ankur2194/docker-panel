# Copy to .env and fill in. Real environment variables override this file.

# Address the panel listens on. Put it behind a TLS reverse proxy for remote access.
HOST=127.0.0.1
PORT=8080

# The single admin login. Generate the hash with: npm run hash-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12

# auto = Secure cookie when served over HTTPS (or X-Forwarded-Proto: https); true / false to force.
COOKIE_SECURE=auto

# Where the panel keeps its project registry (projects.json).
DATA_DIR=./data

# Optional, comma separated: folders scanned (2 levels deep) for compose projects in "Discover".
# Projects can still live anywhere; these are only search hints.
SCAN_ROOTS=/opt/stacks,/srv

# Pre-filled parent folder for "New project" (any absolute path can be typed instead).
DEFAULT_PROJECTS_DIR=/opt/stacks

# Docker CLI binary (needs the compose v2 plugin).
DOCKER_BIN=docker
